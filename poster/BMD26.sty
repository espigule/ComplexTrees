%----------------------------------------------------




%  PAGE SETTINGS  ------------------------------
\@ifpackageloaded{beamerposter}{%
	\setlength{\paperwidth}{70cm}\setlength{\paperheight}{140cm}%
	\geometry{paperwidth=\the\paperwidth,paperheight=\the\paperheight}%
	%	\PackageWarning{BMD26}{beamerposter was loaded before BMD26.\MessageBreak
		%		Paper size forced to 70 x 140 cm, but the font size still\MessageBreak
		%		follows the options you gave beamerposter}%
}{%
	\RequirePackage[size=custom, orientation=portrait, width=70,height=140]{beamerposter}%
}

% frame 
\newlength{\BMDcardx}     \setlength{\BMDcardx}{3cm}  % page edge  -> card, l/r
\newlength{\BMDcardb}     \setlength{\BMDcardb}{10cm}  % page bottom-> card
\newlength{\BMDpadx}      \setlength{\BMDpadx}{0.5cm} % card       -> text, l/r
\newlength{\BMDpadt}      \setlength{\BMDpadt}{1cm}   % card top   -> text
\newlength{\BMDpadb}      \setlength{\BMDpadb}{3cm}   % text       -> card bottom
\newlength{\BMDcolsep}    \setlength{\BMDcolsep}{2cm} % gap between the columns
\newlength{\BMDpin}       \setlength{\BMDpin}{1cm}    % empty margin for pins

\newlength{\BMDheadermin} \setlength{\BMDheadermin}{17cm} % min header height
\newlength{\BMDheadertop} \setlength{\BMDheadertop}{3cm}  % page top -> title
\newlength{\BMDheaderbot} \setlength{\BMDheaderbot}{2cm}  % header   -> card top
\newlength{\BMDtitlegap}  \setlength{\BMDtitlegap}{1cm}   % title    -> authors
\newlength{\BMDheadgap}   \setlength{\BMDheadgap}{4cm}    % gap title-> logo
\newlength{\BMDqrheight}  \setlength{\BMDqrheight}{3.5cm}
\newlength{\BMDqrgap}     \setlength{\BMDqrgap}{1cm}   % gap authors -> QR code

\newlength{\BMDafflogoheight} \setlength{\BMDafflogoheight}{9cm} % BMD logo, bottom right
\newlength{\BMDafflogowidth} \setlength{\BMDafflogowidth}{14cm} % BMD logo, bottom right

\newlength{\BMDfootlogoheight}\setlength{\BMDfootlogoheight}{5.5cm}

% fonts and colors
\let\BMD@Huge\Huge
\let\BMD@Large\Large
\let\BMD@normalsize\normalsize

\def\BMDheaderfont{\fontfamily{lmss}\selectfont}
\def\BMDtitlefont{\BMDheaderfont\BMD@Huge\bfseries}
\def\BMDauthorfont{\BMDheaderfont\BMD@Large\bfseries}
\def\BMDinstitutefont{\BMD@normalsize}

\definecolor{BMD_background}{HTML}{1C75BC}
\setbeamercolor{title in headline}{fg=BMD_background!05!white}
\setbeamercolor{author in headline}{fg=BMD_background!05!white}
\setbeamercolor{institute in headline}{fg=BMD_background!05!white}

\newlength{\BMDinstsep} \setlength{\BMDinstsep}{0em} % Break of \and in \institution
\def\beamer@andinst{\\[\BMDinstsep]}

% corresponding author
\newcommand{\corresponding}[1]{\underline{#1}}

% qrcode and affiliation logo
\gdef\BMD@afflogo{}
\gdef\BMD@qr{}
\newcommand{\BMDaffiliationLogo}[1]{\gdef\BMD@afflogo{#1}}
\newcommand{\BMDqrCode}[1]{\gdef\BMD@qr{#1}}

% images from LOGOS folder
\def\BMDlogosfolder{BMD26}
\def\BMDbackgroundimage{\BMDlogosfolder/background}
\def\BMDmainlogo{\BMDlogosfolder/bmd_logo}
\def\BMDfooter{%
	\includegraphics[height=\BMDfootlogoheight]{\BMDlogosfolder/iec_logo}\hspace{2cm}%
	\includegraphics[height=\BMDfootlogoheight]{\BMDlogosfolder/scm_logo}%
}


% computed distances
\newlength{\BMDmargin}        % page edge -> text
\newlength{\BMDcontentwidth}  % width of the text area (= \textwidth)
\newlength{\BMD@foot}         % height of the footline box
\newlength{\BMD@titlew}       % width of the title block
\newlength{\BMD@footmid}      % height at which the footer logos are centred
\newdimen\BMDheader           % height of the blue band actually used
\newsavebox\BMD@head
\newsavebox\BMD@qrbox

\newcommand*{\BMDrecalc}{%
	\setlength{\BMDmargin}{\BMDcardx+\BMDpadx}%
	\setlength{\BMDcontentwidth}{\paperwidth-2\BMDmargin}%
	\ifx\BMD@afflogo\@empty
	\setlength{\BMD@titlew}{\BMDcontentwidth}%
	\else
	\setlength{\BMD@titlew}{\BMDcontentwidth-\BMDafflogowidth-\BMDheadgap}%
	\fi
	
	%% beamer counts \footheight as ht+dp+4pt, so take the 4pt off here
	\setlength{\BMD@foot}{\BMDcardb+\BMDpadb-4pt}%
	%% the footer logos sit halfway between the pin margin and the card
	\setlength{\BMD@footmid}{\BMDcardb+\BMDpin}\divide\BMD@footmid by 2\relax
	\BMDheader=\BMDheadermin\relax
	\setbeamersize{text margin left=\BMDmargin,text margin right=\BMDmargin}%
}
\BMDrecalc

%----------------------------------------------------





%%  HANDLE POSSIBLE COLLISIONS WITH OTHER PACKAGES --------

%% avoid default drawings by other packages
\setbeamertemplate{headline rule}{}
\setbeamertemplate{navigation symbols}{}


\beamer@onlytextwidthtrue   % columns span the text area, not the whole page
\beamer@centeredfalse       % frames behave as [t] even without the option

%% FOR EDITOR ONLY. Poster templates may write \setlength{\colwidth}{0.3\paperwidth}. 
%% For this template, the text area is narrower than the page, so shrink such lengths 
%% in the same proportion. Adjust them accordingly by adding them to the list:
%%         \BMDrescalelengths{...};      [norescale] switches it off.
\newif\ifBMD@oldrefs
\newcommand*{\BMDrescalelengths}[1]{%
	\def\BMD@list{#1}%
	\@for\BMD@n:=\BMD@list\do{\@ifundefined{\BMD@n}{}{\BMD@oldrefstrue}}%
}
\BMDrescalelengths{sepwidth,colwidth,sepwid,onecolwid,twocolwid,threecolwid}

\newcommand*{\BMD@rescale}{%
	\ifBMD@oldrefs \dimen@=\BMD@oldpaperwidth \else \dimen@=\paperwidth \fi
	\@for\BMD@n:=\BMD@list\do{%
		\@ifundefined{\BMD@n}{}{%
			\expandafter\BMD@shrink\csname\BMD@n\endcsname}}%
}
\newcommand*{\BMD@shrink}[1]{% #1 <- #1 * \BMDcontentwidth / \dimen@
	\setlength{#1}{\dimexpr#1*\numexpr\number\dimexpr\BMDcontentwidth\relax/1000\relax
		/\numexpr\number\dimen@/1000\relax\relax}%
}

\newcommand*{\BMDspacing}{%
	\setlength{\parskip}{0.3\baselineskip}%
	\setlength{\smallskipamount}{0.25\baselineskip}%
	\setlength{\medskipamount}{0.5\baselineskip}%
	\setlength{\bigskipamount}{\baselineskip}%
	\setlength{\abovedisplayskip}{0.5\baselineskip}%
	\setlength{\belowdisplayskip}{0.5\baselineskip}%
	\setlength{\abovedisplayshortskip}{0.25\baselineskip}%
	\setlength{\belowdisplayshortskip}{0.25\baselineskip}%
}

\newcommand*{\BMDlists}{%
	\def\@listi{\leftmargin\leftmargini
		\topsep\z@skip \partopsep\z@skip \parsep\z@skip
		\itemsep .25\baselineskip}\let\@listI\@listi
	\def\@listii{\leftmargin\leftmarginii
		\topsep\z@skip \partopsep\z@skip \parsep\z@skip
		\itemsep .2\baselineskip}%
	\def\@listiii{\leftmargin\leftmarginiii
		\topsep\z@skip \partopsep\z@skip \parsep\z@skip
		\itemsep .15\baselineskip}}

%% -----------------------------------------



%%  POSTER DESIGN  ---------------------------------
% background (image + main color + tint)
\newcommand*{\BMD@paint}{%
	\ifx\BMDbackgroundimage\@empty\else
	\node[inner sep=0pt, opacity=1] at (current page.center)
%	{\includegraphics[width=\paperwidth]{\BMDbackgroundimage}};
{\includegraphics[height=\paperheight]{\BMDlogosfolder/barcelona}};
	\fi
	\fill[black!15!BMD_background,opacity=0.85]
	(current page.south west) rectangle (current page.north east);
}

% header pieces (title, authors/affiliations, QR and BMD logo)
\newcommand*{\BMD@titleblock}{%
	\usebeamercolor[fg]{title in headline}%
	{\color{fg}\BMDtitlefont\inserttitle\par}%
}

\newcommand*{\BMD@authorblock}{%
	\usebeamercolor[fg]{author in headline}%
	{\color{fg}\BMDauthorfont\insertauthor\par}%
	\vskip2ex
	\usebeamercolor[fg]{institute in headline}%
	{\color{fg}\BMDinstitutefont\insertinstitute\par}%
}

%% authors on the left, QR code (if there is one) flush with the right edge of
%% the title block, so that it never reaches into the space kept for the logo
\newcommand*{\BMD@authorrow}{%
	\sbox\BMD@qrbox{%
		\ifx\BMD@qr\@empty\else\adjustbox{height=\BMDqrheight}{\BMD@qr}\fi}%
	\ifdim\wd\BMD@qrbox>\z@
	\dimen2=\linewidth
	\advance\dimen2 by -\wd\BMD@qrbox
	\advance\dimen2 by -\BMDqrgap\relax
	\begin{minipage}[c]{\dimen2}\BMD@authorblock\end{minipage}%
	\hspace*{\BMDqrgap}%
	\begin{minipage}[c]{\wd\BMD@qrbox}\usebox\BMD@qrbox\end{minipage}%
	\else
	\BMD@authorblock
	\fi
}

%% one row, exactly \paperwidth wide:
%%    margin | title block | headgap | BMD logo | margin
\newcommand*{\BMD@headercontent}{%
	\hspace*{\BMDmargin}%
	\begin{minipage}[t]{\BMD@titlew}%
		\vspace{0pt}\raggedright
		\BMD@titleblock
		\vskip\BMDtitlegap
		\BMD@authorrow
	\end{minipage}%
	\ifx\BMD@afflogo\@empty\else
	\hspace*{\BMDheadgap}%
	\begin{minipage}[t]{\BMDafflogowidth}%
		\vspace{0pt}\raggedleft
		\adjustbox{max height=\BMDafflogoheight, max width=\BMDafflogowidth}{\BMD@afflogo}%
	\end{minipage}%
	\fi
	\hspace*{\BMDmargin}%
}

%% the header.  Its height is what beamer uses to decide where the text starts,
%% so the blue band grows with the header and the card top follows it
\newcommand*{\BMD@headline}{%
	\sbox\BMD@head{\BMD@headercontent}%
	\dimen@=\dimexpr\BMDpin+\BMDheadertop+\ht\BMD@head+\dp\BMD@head
	+\BMDheaderbot\relax
	\ifdim\dimen@<\BMDheadermin \dimen@=\BMDheadermin\relax\fi
	\global\BMDheader=\dimen@
	\vbox to \dimexpr\BMDheader+\BMDpadt\relax{%
		\offinterlineskip\parskip\z@
				%% the band itself: the content is centred in whatever room is left
		%% between \BMDpin+\BMDheadertop above and \BMDheaderbot below
		\vbox to \BMDheader{%
			\vskip\BMDpin \vskip\BMDheadertop
			\vfil \box\BMD@head \vfil
			\vskip\BMDheaderbot}%
		\vskip\BMDpadt}%
}

%% the footer.  It is printed after the text, so if a column is too long the
%% band covers the overflow instead of the text covering the \BMDlogosfolder. In that
%% case, returns "Overfull \vbox ... too high"
\newcommand*{\BMD@footline}{%
	\vbox to \BMD@foot{%
		\offinterlineskip\parskip\z@
		\hbox to \paperwidth{%
			\begin{tikzpicture}[remember picture,overlay]
				\begin{scope}
					\clip[rounded corners= 40pt] (current page.south west)
					rectangle ([yshift=\BMDcardb]current page.south east);
					\BMD@paint
				\end{scope}
				\node[anchor=west,inner sep=0pt]
				at ([xshift=\BMDcardx,yshift=\BMD@footmid]current page.south west)
				{\BMDfooter};
				\node[anchor=east,inner sep=0pt]
				at ([xshift=-\BMDcardx,yshift=\BMD@footmid]current page.south east)
				{\includegraphics[height=\BMDfootlogoheight]{\BMDmainlogo}};
			\end{tikzpicture}\hfil}%
		\vfil}%
}

% background (image + color + tint) and the white card
\newcommand*{\BMD@canvas}{%
	\begin{tikzpicture}[remember picture,overlay]
		\BMD@paint
		\fill[white, rounded corners = 40pt]
		([xshift=\BMDcardx,yshift=\BMDcardb]current page.south west)
		rectangle
		([xshift=-\BMDcardx,yshift=-\BMDheader]current page.north east);
	\end{tikzpicture}%
}

%% Set up at \begin{document}, so that the preamble has run by then
	%% and the template can enforce options over other packages
	\AtBeginDocument{%
		\BMDrecalc
		\BMDspacing
		\g@addto@macro\normalsize{\BMDspacing}
		\setlength{\leftmargini}{1\baselineskip}
		\setlength{\leftmarginii}{1\baselineskip}
		\BMDlists
		%% a plain assignment, not \setlength: calc's version borrows \@tempdima,
		%% which the enclosing minipage is using at that very moment
		\g@addto@macro\@parboxrestore{\parskip=0.4\baselineskip\relax}
		%% \begin{document} has already copied the old \textwidth into these three
			\columnwidth\textwidth \hsize\textwidth \linewidth\textwidth
			\ifBMD@rescale\BMD@rescale\fi
			%% two columns and one gutter, filling the text area exactly.  The
			%% values are assigned, not merely defaulted, so a poster that brings
			%% its own widths is corrected instead of leaving a gap.
			\@ifundefined{sepwidth}{\newlength{\sepwidth}}{}%
			\@ifundefined{colwidth}{\newlength{\colwidth}}{}%
			\setlength{\sepwidth}{\BMDcolsep}%
			\setlength{\colwidth}{\BMDcontentwidth-3\BMDcolsep}\divide\colwidth by 2\relax
			\@ifundefined{separatorcolumn}%
			{\newcommand{\separatorcolumn}{\begin{column}{\sepwidth}\end{column}}}{}%
			%
			
			\setbeamertemplate{headline}{\BMD@headline}%
			\setbeamertemplate{footline}{\BMD@footline}%
			\setbeamertemplate{background canvas}{\BMD@canvas}%
		}
		\endinput		
		% -------------------------------------------------------------