\newif\ifBMD@rescale \BMD@rescaletrue
\def\BMD@posteropts{}
\DeclareOption{norescale}{\BMD@rescalefalse}   % see section 5
\DeclareOption*{\edef\BMD@posteropts{\BMD@posteropts\CurrentOption,}}
\ProcessOptions\relax

\newlength{\BMD@oldpaperwidth}
\setlength{\BMD@oldpaperwidth}{\paperwidth}    % before we resize the page

\RequirePackage{beamerposter}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{adjustbox}
\RequirePackage{xcolor}
